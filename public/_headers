/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Stylesheets and scripts are checked for a newer version on every visit (a quick "not modified" reply when
# nothing changed), so a deploy reaches phones straight away instead of after an hour.
/css/*
  Cache-Control: no-cache

/js/*
  Cache-Control: no-cache

/admin/*
  Cache-Control: no-cache

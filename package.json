{
  "name": "irishbredeventers",
  "private": true,
  "type": "module",
  "description": "IrishBredEventers: Irish-bred eventing results. Cloudflare Workers (static assets) + D1 + R2.",
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply irishbredeventers --local",
    "db:migrate:remote": "wrangler d1 migrations apply irishbredeventers --remote",
    "parse": "node scripts/parse-file.mjs",
    "test": "node --test tests/*.test.js",
    "deploy": "wrangler deploy",
    "db:reset:local": "rm -rf .wrangler/state/v3/d1 && wrangler d1 migrations apply irishbredeventers --local",
    "import:local": "node scripts/import-file.mjs",
    "ads:local": "node scripts/load-example-ads.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.40.0"
  },
  "engines": {
    "node": ">=20"
  }
}

{
  "name": "irishbredeventers",
  "private": true,
  "type": "module",
  "description": "IrishBredEventers: Irish-bred eventing results. Cloudflare Pages + Functions + D1 + R2.",
  "scripts": {
    "dev": "wrangler pages dev",
    "db:migrate:local": "wrangler d1 migrations apply irishbredeventers --local",
    "db:seed:local": "wrangler d1 execute irishbredeventers --local --file seed/sample.sql",
    "db:migrate:remote": "wrangler d1 migrations apply irishbredeventers --remote",
    "db:seed:remote": "wrangler d1 execute irishbredeventers --remote --file seed/sample.sql",
    "seed:build": "node scripts/build-seed.mjs",
    "parse": "node scripts/parse-file.mjs",
    "test": "node --test tests/*.test.js",
    "deploy": "wrangler pages deploy"
  },
  "devDependencies": {
    "wrangler": "^4.40.0"
  },
  "engines": {
    "node": ">=20"
  }
}

// IrishBredEventers on Cloudflare Workers.
// Static pages come from /public. /api/*, /media/*, the owner area (/admin) and the sign-in path
// run the Worker code first (src/worker.js), which returns 404 for /admin to anyone not logged in.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "irishbredeventers",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*", "/admin", "/admin/*", "/signin", "/signin/*"]
  },
  // D1 database. With no database_id, the first deploy creates it and later deploys reuse it.
  // Create the tables once after that: npm run db:migrate:remote
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "irishbredeventers",
      "migrations_dir": "migrations"
    }
  ],
  // R2 bucket for news photos and ad images (created on first deploy if missing).
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "irishbredeventers-media"
    }
  ],
  // Keep the variables set in the Cloudflare dashboard (Worker → Settings → Variables and Secrets)
  // on every deploy. Only the values listed under "vars" below are set from this file; anything set
  // here would overwrite the dashboard value of the same name, so the owner-login settings live ONLY
  // in the dashboard:
  //   ACCESS_TEAM_DOMAIN  Cloudflare Access team domain, e.g. yourteam.cloudflareaccess.com
  //   ACCESS_AUD          Audience (AUD) tag of the Access application that guards /signin
  //                       (not /admin: /admin must stay a plain 404 to the public)
  //   ADMIN_EMAILS        Emails allowed into the owner area (comma separated)
  //   TURNSTILE_SITE_KEY  Turnstile site key (public); the secret is the secret TURNSTILE_SECRET
  //   ENQUIRY_EMAIL       Optional: where advertising enquiries are emailed
  // Secrets (TURNSTILE_SECRET, MAIL_API_KEY) are never touched by a deploy.
  "keep_vars": true,
  "vars": {
    // Public web address, used in email links. Change once the .ie domain is live.
    "SITE_URL": "https://irishbredeventers.emerblakeey.workers.dev",
    // Mailing service: "resend" or "brevo". The API key is added as a secret: MAIL_API_KEY.
    "MAIL_PROVIDER": "resend",
    "MAIL_FROM": "IrishBredEventers <results@irishbredeventing.ie>"
  },
  "observability": { "enabled": true }
}
